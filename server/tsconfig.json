{
  "compilerOptions": {
    "rootDir": "..",
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    // Load-bearing: `paths` below are resolved against it, and the generated
    // Prisma client is imported as the bare specifier `generated/prisma`.
    // Removing this breaks `bun build src/app.ts`, which is what produces the
    // serverless bundle — so the API silently disappears from a deploy.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Explicit, rather than relying on baseUrl alone to resolve the bare
      // specifier, so the mapping survives someone tidying baseUrl away again.
      "generated/*": ["./generated/*"],
      "@myapp/shared": ["../packages/shared/src/index.ts"],
      "@myapp/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src", "../packages/shared/src/schemas"]
}
