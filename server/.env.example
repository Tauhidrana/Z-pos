DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
RESEND_API_KEY=re_your_resend_api_key
CLIENT_URL=http://localhost:5173
EMAIL_DOMAIN=yourdomain.com

# Comma-separated admin emails. Sign-up is self-serve — any account that signs
# in gets its own shop as an OWNER — so this is not what grants access. It is
# what keeps it: these addresses are restored to an active OWNER on every cache
# miss, so a deactivation or demotion can never lock the operator out.
BOOTSTRAP_OWNER_EMAILS=
