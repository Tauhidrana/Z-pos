// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  STAFF
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
}

// PAID     → sum(payments.amount) >= sale.total
// PARTIAL  → 0 < sum < total
// DUE      → sum == 0
// WAIVED   → sale has waived_amount covering the gap (still unpaid in cash)
// Compute this in application; do not persist it.
enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

enum StockDirection {
  IN
  OUT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Fulfilment stages an online (storefront) order moves through. Deliberately
/// separate from `SaleStatus`, which describes an in-person POS sale that is
/// already money in the till the moment it is rung up. An online order is a
/// promise until it is delivered.
enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Only cash on delivery today. The column exists so adding bKash/Nagad later
/// is a migration on this enum rather than a rewrite of the checkout.
enum OnlineOrderPaymentMethod {
  COD
}

/// What an emailed customer token is for. Kept apart so a verification link
/// can never be replayed as a password reset.
enum CustomerTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─────────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

/// One retail business. Everything a shop owns — catalog, customers, suppliers,
/// sales, purchases — hangs off this, and every query is filtered by it.
///
/// Before this existed the whole database was a single shared dataset: any
/// signed-in account saw every other account's products and could edit them,
/// because nothing recorded who anything belonged to.
///
/// The boundary is the shop, not the user: an OWNER's invited STAFF work the
/// same catalog, which is the point of the invite flow. Two owners never see
/// each other's data.
model Shop {
  id   String @id @default(uuid())
  name String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users            User[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  suppliers        Supplier[]
  sales            Sale[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
  counters         Counter[]
  store            Store?
  onlineOrders     OnlineOrder[]
  mediaAssets      MediaAsset[]

  @@map("shops")
}

model User {
  id        String       @id @default(uuid())
  clerk_id  String?      @unique
  /// Nullable only so an invite row can exist before its shop is resolved;
  /// every admitted session is required to have one.
  shop_id   String?
  name      String?
  email     String       @unique
  phone     String?      @unique
  status    InviteStatus @default(PENDING)
  role      Role         @default(OWNER)
  is_active Boolean      @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop              Shop?                      @relation(fields: [shop_id], references: [id], onDelete: SetNull)
  sales             Sale[]
  purchases         Purchase[]
  stockAdjustments  StockAdjustment[]
  barcodesRetired   Barcode[]                  @relation("BarcodeRetirer")
  barcodesAllocated VariantBarcodeAllocation[] @relation("BarcodeAllocator")

  @@index([email])
  @@index([clerk_id])
  @@index([shop_id])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String  @id @default(uuid())
  shop_id        String
  name           String  @default("Walk-in Customer")
  /// Unique per shop, not globally: two shops may each have a customer on the
  /// same number, and a global unique would let one shop's data block another's.
  phone          String?
  email          String?
  address        String?
  credit_balance Decimal @default(0) @db.Decimal(10, 2)
  is_active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop           Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  sales          Sale[]
  onlineOrders   OnlineOrder[]
  storeCustomers StoreCustomer[]

  @@unique([shop_id, phone])
  @@index([shop_id])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Products & Variants
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(uuid())
  shop_id     String
  name        String
  slug        String
  description String?
  parent_id   String?
  is_active   Boolean @default(true)

  /// Storefront artwork — `media:<id>` or an absolute URL. Null renders the
  /// existing typographic tile, so a shop that never uploads one still has a
  /// finished-looking category section rather than a grey placeholder.
  image_url String?
  /// Ascending order in the storefront's category rail. Ties fall back to name,
  /// so an untouched catalog stays alphabetical.
  position  Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop     Shop       @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([shop_id, name])
  @@unique([shop_id, slug])
  @@index([shop_id])
  @@index([parent_id])
  @@map("categories")
}

model Product {
  id             String  @id @default(uuid())
  shop_id        String
  name           String
  normalized_key String // lowercased+stripped for duplicate detection
  description    String?
  category_id    String
  brand          String?
  reorder_level  Int     @default(0)
  is_active      Boolean @default(true)

  /// URL segment for the storefront, unique within the shop. Nullable because
  /// a product is reachable by id as well — a slug that has not been generated
  /// yet must never make the product unroutable.
  slug           String?
  /// Whether the storefront lists this product. Defaults to true so a catalog
  /// that already exists appears the moment the merchant opens their store;
  /// hiding a single product stays a deliberate act.
  online_visible Boolean @default(true)
  /// Promoted into the storefront's "Featured" rail.
  is_featured    Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop     Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]
  wishlist WishlistItem[]

  @@unique([shop_id, slug])
  @@index([shop_id])
  @@index([category_id])
  @@index([shop_id, normalized_key])
  @@index([shop_id, online_visible, is_active])
  @@map("products")
}

/// An uploaded image, stored in the database.
///
/// The deployment has no object storage — no S3 bucket, no blob store, nothing
/// to hold a file — and adding one would mean provisioning and configuring
/// infrastructure before a merchant could put a photograph on a product. So the
/// bytes live here and are served by `GET /api/media/:id`.
///
/// This is only sane because the client shrinks every upload before sending it:
/// a phone photo comes off the camera at 4-6 MB and arrives here at roughly
/// 100-250 kB. `MAX_IMAGE_BYTES` on the server is the hard backstop.
///
/// If an object store is added later, this table becomes the fallback: the
/// column that changes is the storage key, not anything a caller sees.
model MediaAsset {
  id      String @id @default(uuid())
  shop_id String

  mime   String
  /// Byte length, denormalized so a listing never has to read the image.
  size   Int
  width  Int?
  height Int?

  /// Where the image actually lives, for assets stored in blob storage: an
  /// absolute, CDN-served URL. This is the reference handed back to the app and
  /// written into products, banners and categories, so a storefront loads its
  /// pictures straight from the CDN without touching this API at all.
  ///
  /// The row still exists for such assets, and that is the point: it is what
  /// proves which shop owns the image, so `resolveImageRefs` can keep refusing
  /// to attach one shop's photograph to another shop's product.
  url      String? @unique
  /// The object's key in the blob store, kept so it can be deleted later.
  pathname String?

  /// Image bytes, for assets stored in the database.
  ///
  /// Nullable since blob storage became the default: new uploads set `url` and
  /// leave this empty. Rows written before that still carry their bytes and are
  /// still served from `/api/media/:id`, so no existing image breaks and there
  /// is no migration to run over live product photographs.
  data Bytes?

  created_at DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@index([shop_id])
  @@index([shop_id, created_at])
  @@map("media_assets")
}

/// Storefront imagery for a product. The POS never renders these; they exist
/// so an online listing can show more than a name.
///
/// `url` holds one of two things:
///   • `media:<uuid>` — an upload, resolved against `MediaAsset`. This is what
///     everything written through the app produces.
///   • an absolute `http(s)://` URL — tolerated on read so images that predate
///     uploads keep rendering, but no longer offered anywhere in the UI.
model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  url        String
  alt        String?
  /// Ascending; position 0 is the listing thumbnail.
  position   Int     @default(0)

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, position])
  @@map("product_images")
}

model ProductVariant {
  id         String  @id @default(uuid())
  product_id String
  name       String? // e.g. "Red / XL" — null if product has only one variant
  color      String?
  size       String?
  is_active  Boolean @default(true)

  // Denormalized running stock, kept in sync with StockLedger inside the same
  // transaction as every ledger write (and under the same `FOR UPDATE` lock on
  // this row). The ledger stays the append-only source of truth for history;
  // this column exists so reads don't have to scan it.
  //
  // Deriving current stock used to require a `DISTINCT ON (variant_id)` over
  // the whole stock_ledgers table on every product list, POS search and stats
  // call — an O(all movements ever) scan on the hottest read path in the app.
  stock_on_hand Int @default(0)

  // ── Pricing ───────────────────────────────────────────────────────────────
  // The POS prices a unit from the purchase batch its scanned barcode belongs
  // to, which is exact at the till but unreachable for a storefront: a web
  // shopper has no barcode in their hand, so there is no batch to price from.
  //
  // `last_sell_price` is the sell price from this variant's most recent
  // purchase, denormalized on every purchase the same way `stock_on_hand` is.
  // It is the shelf price — what the next unit sold would cost — and it is what
  // the storefront quotes when the merchant has not overridden it.
  last_sell_price Decimal? @db.Decimal(10, 2)

  /// Overrides `last_sell_price` online only. The POS is untouched by it.
  online_price      Decimal? @db.Decimal(10, 2)
  /// A temporary discount. Shown as the price, with the regular price struck
  /// through, whenever it is set and below the regular price.
  online_sale_price Decimal? @db.Decimal(10, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  saleItems                 SaleItem[]
  onlineOrderItems          OnlineOrderItem[]
  purchaseItems             PurchaseItem[]
  stockAdjustmentItems      StockAdjustmentItem[]
  stockLedgers              StockLedger[]
  variantBarcodeAllocations VariantBarcodeAllocation[]

  @@index([product_id])
  @@index([product_id, is_active])
  @@map("product_variants")
}

enum BarcodeStatus {
  UNALLOCATED // sitting in the drawer, ready to use
  ALLOCATED // assigned to a product variant
  RETIRED // sticker damaged, duplicate scan, decommissioned
}

model Barcode {
  id     String        @id @default(uuid())
  code   String        @unique
  serial Int           @default(autoincrement())
  status BarcodeStatus @default(UNALLOCATED)

  retired_by String?
  retired_at DateTime?

  created_at DateTime @default(now())

  retiredByUser User?                     @relation("BarcodeRetirer", fields: [retired_by], references: [id], onDelete: SetNull)
  allocation    VariantBarcodeAllocation? // null until allocated

  @@index([code])
  @@index([status])
  @@index([serial])
  @@map("barcodes")
}

// The join table — barcode + variant + purchase batch
model VariantBarcodeAllocation {
  id String @id @default(uuid())

  barcode_id       String @unique // one barcode → one allocation at a time
  variant_id       String
  purchase_item_id String // which purchase batch this unit came from

  allocated_by String
  allocated_at DateTime @default(now())

  barcode         Barcode        @relation(fields: [barcode_id], references: [id], onDelete: Restrict)
  variant         ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  purchaseItem    PurchaseItem   @relation(fields: [purchase_item_id], references: [id], onDelete: Restrict)
  allocatedByUser User           @relation("BarcodeAllocator", fields: [allocated_by], references: [id], onDelete: Restrict)

  @@index([barcode_id])
  @@index([variant_id])
  @@index([purchase_item_id])
  @@map("variant_barcode_allocations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchasing
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id      String  @id @default(uuid())
  shop_id String
  name    String
  phone   String?
  email   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop      Shop       @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([shop_id, phone])
  @@unique([shop_id, email])
  @@index([shop_id])
  @@map("suppliers")
}

model Purchase {
  id          String  @id @default(uuid())
  shop_id     String
  supplier_id String?
  user_id     String

  total      Decimal @db.Decimal(10, 2)
  note       String?
  invoice_no String?

  date       DateTime
  created_at DateTime @default(now())

  shop     Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Restrict)

  items        PurchaseItem[]
  stockLedgers StockLedger[]

  @@index([shop_id])
  @@index([shop_id, date])
  @@index([supplier_id])
  @@index([user_id])
  @@index([invoice_no])
  @@index([created_at])
  @@index([date])
  @@index([date, invoice_no])
  @@map("purchases")
}

model PurchaseItem {
  id          String @id @default(uuid())
  purchase_id String
  variant_id  String

  quantity   Int
  cost_price Decimal @db.Decimal(10, 2) // price at time of purchase (snapshot)
  sell_price Decimal @db.Decimal(10, 2) // price at time of purchase (snapshot)
  total      Decimal @db.Decimal(10, 2)

  purchase                  Purchase                   @relation(fields: [purchase_id], references: [id], onDelete: Restrict)
  variant                   ProductVariant             @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  variantBarcodeAllocations VariantBarcodeAllocation[]

  @@index([purchase_id])
  @@index([variant_id])
  @@index([purchase_id, variant_id])
  @@map("purchase_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoice Counter  (use SELECT ... FOR UPDATE or atomic increment only)
// ─────────────────────────────────────────────────────────────────────────────

model Counter {
  shop_id String
  key     String // e.g. "invoice"
  value   Int

  shop Shop @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@id([shop_id, key])
  @@map("counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id             String     @id @default(uuid())
  shop_id        String
  user_id        String
  customer_id    String?
  /// Numbered from a per-shop counter, so it is unique within a shop rather
  /// than globally — two shops both starting at INV-1001 is correct.
  invoice_number String
  invoiced_at    DateTime
  status         SaleStatus @default(COMPLETED)

  subtotal        Decimal @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)
  tax_amount      Decimal @default(0) @db.Decimal(10, 2)
  waived_amount   Decimal @default(0) @db.Decimal(10, 2)
  /// Always 0 for a counter sale; carries the shipping fee for a delivered
  /// online order, so `total` stays the amount actually collected.
  delivery_charge Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  note String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop     Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  items        SaleItem[]
  payments     Payment[]
  stockLedgers StockLedger[]
  onlineOrder  OnlineOrder?

  @@unique([shop_id, invoice_number])
  @@index([shop_id])
  @@index([shop_id, invoiced_at])
  @@index([shop_id, status, created_at])
  @@index([user_id])
  @@index([customer_id])
  @@index([invoiced_at])
  @@index([status])
  @@index([invoice_number])
  @@index([invoiced_at, status])
  // Every dashboard panel filters on created_at (not invoiced_at) plus status.
  // Without these, each of the six dashboard requests sequentially scanned the
  // whole sales table on every page load.
  @@index([created_at])
  @@index([status, created_at])
  @@map("sales")
}

model SaleItem {
  id         String @id @default(uuid())
  sale_id    String
  variant_id String

  // Denormalized snapshots — intentional, prices change over time
  product_name String
  variant_name String?
  unit_price   Decimal @db.Decimal(10, 2)

  quantity        Int
  discount_amount Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  sale    Sale           @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([sale_id])
  @@index([variant_id])
  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id      String @id @default(uuid())
  sale_id String

  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String? // bKash TrxID,  auth code, etc.

  created_at DateTime @default(now())

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Restrict)

  @@index([sale_id])
  @@index([method])
  @@index([created_at])
  @@index([method, created_at])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock Ledger  (append-only — never UPDATE or DELETE rows)
// WARNING: balance_after is only consistent if variant stock writes are
// serialized per-variant (e.g. SELECT ... FOR UPDATE on the variant row).
// ─────────────────────────────────────────────────────────────────────────────

model StockLedger {
  id         String @id @default(uuid())
  variant_id String

  type          StockMovementType
  direction     StockDirection
  quantity      Int
  balance_after Int

  // Exactly one non-null per row
  sale_id         String?
  purchase_id     String?
  adjustment_id   String?
  /// A storefront order reserves stock the moment it is placed, long before it
  /// becomes a Sale — so it is a movement source in its own right rather than
  /// something squeezed into `sale_id`.
  online_order_id String?

  created_at DateTime @default(now())

  variant     ProductVariant   @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  sale        Sale?            @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  purchase    Purchase?        @relation(fields: [purchase_id], references: [id], onDelete: SetNull)
  adjustment  StockAdjustment? @relation(fields: [adjustment_id], references: [id], onDelete: SetNull)
  onlineOrder OnlineOrder?     @relation(fields: [online_order_id], references: [id], onDelete: SetNull)

  @@index([variant_id])
  @@index([variant_id, created_at])
  @@index([sale_id])
  @@index([purchase_id])
  @@index([adjustment_id])
  @@index([online_order_id])
  @@map("stock_ledgers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock Adjustments
// ─────────────────────────────────────────────────────────────────────────────

model StockAdjustment {
  id          String  @id @default(uuid())
  shop_id     String
  adjusted_by String
  reason      String?
  note        String?

  created_at DateTime @default(now())

  shop           Shop @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  adjustedByUser User @relation(fields: [adjusted_by], references: [id], onDelete: Restrict)

  items        StockAdjustmentItem[]
  stockLedgers StockLedger[]

  @@index([shop_id])
  @@index([adjusted_by])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id            String @id @default(uuid())
  adjustment_id String
  variant_id    String

  direction StockDirection
  quantity  Int
  note      String?

  adjustment StockAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Restrict)
  variant    ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([adjustment_id])
  @@index([variant_id])
  @@map("stock_adjustment_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Online store (storefront)
// ─────────────────────────────────────────────────────────────────────────────

/// A shop's public storefront. One per shop — the catalog, categories and
/// customers a storefront sells from are the shop's own, so a second store
/// would only ever be a second skin on the same data.
///
/// `slug` is the tenant key the public site resolves by: `tds.example.com` or
/// `/s/tds` both land on the store whose slug is `tds`. It is globally unique
/// because it is a hostname, not a per-shop label.
model Store {
  id      String @id @default(uuid())
  shop_id String @unique
  slug    String @unique

  name        String
  description String?

  logo_url    String?
  banner_url  String?
  favicon_url String?

  phone   String?
  email   String?
  address String?

  facebook_url    String?
  instagram_url   String?
  whatsapp_number String?

  // ── Business location ────────────────────────────────────────────────────
  /// Where the shop physically is. Stored alongside the free-text `address`
  /// rather than replacing it: a courier reads the text, a map needs the pair.
  /// Both nullable — a merchant who never opens the map picker still has a
  /// complete store.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // ── Published policy pages ───────────────────────────────────────────────
  // Long-form text the storefront renders as its own pages and links from the
  // footer. Empty means "no such page", and the footer link is hidden rather
  // than leading somewhere blank.
  delivery_info  String? @db.Text
  return_policy  String? @db.Text
  terms          String? @db.Text
  privacy_policy String? @db.Text
  /// Free text ("Sat-Thu 10am-8pm, Fri closed") rather than structured hours:
  /// a shop's real opening pattern rarely survives a rigid seven-row model,
  /// and this is displayed, never computed against.
  opening_hours  String?

  // ── SEO ──────────────────────────────────────────────────────────────────
  // Overrides for the storefront's <title> and meta description. Null falls
  // back to the store name and description, so an untouched store still gets
  // store-specific tags rather than a generic zPOS one.
  meta_title       String?
  meta_description String?

  /// Flat shipping fee added at checkout, in BDT.
  delivery_charge    Decimal  @default(60) @db.Decimal(10, 2)
  /// Orders at or above this subtotal ship free. Null disables the rule.
  free_delivery_over Decimal? @db.Decimal(10, 2)
  /// Checkout refuses a subtotal below this. 0 disables the rule.
  min_order_amount   Decimal  @default(0) @db.Decimal(10, 2)

  /// Storefront accent colour as a hex string, defaulting to the zPOS rust.
  theme_color String @default("#a8431d")

  /// A disabled store answers with a closed-shop page instead of the catalog.
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop      Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  orders    OnlineOrder[]
  banners   StoreBanner[]
  customers StoreCustomer[]

  @@index([slug])
  @@map("stores")
}

/// One slide in the storefront's hero carousel.
///
/// A separate table rather than more columns on `Store` because a banner is a
/// list, and lists in columns (banner_1_url, banner_2_url …) cannot be
/// reordered, counted or extended. `Store.banner_url` is kept as-is so every
/// existing storefront keeps its cover image; it is treated as the implicit
/// first slide when a store has no rows here yet.
///
/// The five-banner cap is enforced in the API, not here: it is a product
/// decision about what a carousel can hold before shoppers stop swiping, and
/// it belongs where the error message can explain itself.
model StoreBanner {
  id       String @id @default(uuid())
  store_id String

  /// `media:<id>` reference or an absolute URL, same as every other image.
  image_url String

  /// All optional — a banner may be pure artwork with the copy baked into the
  /// image, which is how most merchants will actually use it.
  title       String?
  subtitle    String?
  button_text String?
  /// Where the button goes. A storefront-relative path ("/category/shoes") or
  /// an absolute URL; validated on write so a banner cannot inject javascript:.
  button_link String?

  /// Ascending display order. Gaps are fine — the list is sorted, not indexed.
  position  Int     @default(0)
  /// Lets a merchant retire a seasonal banner without deleting the artwork.
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, position])
  @@index([store_id, is_active, position])
  @@map("store_banners")
}

/// A shopper's account on one merchant's storefront.
///
/// Deliberately NOT the `User` model: that is a zPOS operator authenticated by
/// Clerk with access to a shop's books. A storefront customer is a member of
/// the public with a password, and the two must never share an identity space.
///
/// Deliberately NOT `Customer` either. `Customer` is the shop's record of a
/// person it has sold to — created by the POS for walk-ins, with no password
/// and no login. Giving it credentials would mean every walk-in silently owned
/// a web account. Instead this links TO a `Customer` row, so a shopper who
/// later buys in person is one person in the merchant's books while only the
/// web identity carries a password.
///
/// Scoped to a store, not to a shop: the account is with the shop the customer
/// chose to buy from, and `@@unique([store_id, email])` means the same address
/// can register independently at two different merchants without either being
/// able to see the other's account.
model StoreCustomer {
  id       String @id @default(uuid())
  store_id String
  /// Denormalized from `store` so tenancy filters and the merchant's customer
  /// list never need a join to answer "is this mine?".
  shop_id  String

  email String
  name  String
  phone String?

  /// scrypt, as `<salt>:<derived key>` in hex. Never leaves the server, and is
  /// excluded from every select outside the auth path.
  password_hash String

  /// Set once the emailed link is followed. An unverified account can still
  /// browse and order — blocking checkout on email delivery would cost real
  /// sales — but cannot reset its password to take over the address.
  email_verified_at DateTime?

  /// Bumped whenever the password changes. Session tokens carry the value they
  /// were issued under, so a reset invalidates every existing session without
  /// a server-side session table to sweep.
  password_version Int @default(0)

  /// The merchant's business record for this person, linked on first order.
  /// Nullable: an account that has never ordered is not yet a customer of the
  /// shop in any accounting sense.
  customer_id String?

  is_active     Boolean   @default(true)
  last_login_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store     Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer  Customer?         @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  addresses CustomerAddress[]
  wishlist  WishlistItem[]
  tokens    CustomerToken[]
  orders    OnlineOrder[]

  @@unique([store_id, email])
  @@index([store_id])
  @@index([shop_id])
  @@index([customer_id])
  @@map("store_customers")
}

/// Single-use, expiring tokens for email verification and password reset.
///
/// A table rather than a signed token in a URL because these must be
/// revocable and single-use: a reset link that still works after it has been
/// used is a reset link sitting in an inbox forever. Only the hash is stored,
/// so a database read does not yield working links.
model CustomerToken {
  id                String            @id @default(uuid())
  store_customer_id String
  kind              CustomerTokenKind
  /// SHA-256 of the token that was emailed. The plaintext exists only in the
  /// message.
  token_hash        String            @unique
  expires_at        DateTime
  used_at           DateTime?

  created_at DateTime @default(now())

  customer StoreCustomer @relation(fields: [store_customer_id], references: [id], onDelete: Cascade)

  @@index([store_customer_id, kind])
  @@index([expires_at])
  @@map("customer_tokens")
}

/// A delivery address in a customer's address book.
///
/// Carries both representations on purpose: the structured Bangladesh triple
/// (division/district/upazila) is what a courier and the merchant's dashboard
/// read, and the coordinate pair is what a map pin sets. Either can be absent —
/// a customer who types their address never opens a map, and a pin dropped on
/// a map still needs the written address underneath it.
model CustomerAddress {
  id                String @id @default(uuid())
  store_customer_id String

  /// "Home", "Office", or whatever the customer typed.
  label          String @default("Home")
  recipient_name String
  phone          String

  division     String
  district     String
  upazila      String
  area         String?
  address_line String
  landmark     String?
  postal_code  String?

  /// Set when the customer places the pin. Null is normal.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// "Third floor, ring the bell twice" — for the rider, not the address.
  delivery_note String?

  /// Exactly one per customer is kept true by the API, which clears the others
  /// in the same transaction as it sets this one.
  is_default Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer StoreCustomer @relation(fields: [store_customer_id], references: [id], onDelete: Cascade)

  @@index([store_customer_id])
  @@index([store_customer_id, is_default])
  @@map("customer_addresses")
}

/// A product a customer saved for later.
///
/// Keyed on the product rather than a variant: a shopper saves "that jacket",
/// and picks the size when they actually buy. The unique pair makes saving
/// twice a no-op instead of a duplicate row.
model WishlistItem {
  id                String @id @default(uuid())
  store_customer_id String
  product_id        String

  created_at DateTime @default(now())

  customer StoreCustomer @relation(fields: [store_customer_id], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([store_customer_id, product_id])
  @@index([store_customer_id, created_at])
  @@map("wishlist_items")
}

/// An order placed on a storefront. Cash on delivery only for now.
///
/// Stock is committed when the order is placed, not when it ships: a customer
/// who checks out has taken the unit off the shelf as far as everyone else
/// browsing is concerned, and holding the decrement until delivery is how a
/// shop oversells. Cancelling returns it (see `stock_restored`).
model OnlineOrder {
  id           String @id @default(uuid())
  shop_id      String
  store_id     String
  /// Numbered from the shop's own counter, so two shops both starting at
  /// ORD-000001 is correct rather than a collision.
  order_number String

  status         OnlineOrderStatus        @default(PENDING)
  payment_method OnlineOrderPaymentMethod @default(COD)

  /// The shop's customer record, reused rather than duplicated: an online
  /// buyer who later walks into the shop is the same person on the same phone
  /// number. Nullable so a failed upsert can never cost the order.
  customer_id    String?
  customer_name  String
  customer_phone String
  customer_email String?

  /// The storefront account that placed it, when the shopper was signed in.
  /// Null for guest checkout, which stays supported — requiring an account to
  /// buy is the single most reliable way to lose an order.
  store_customer_id String?

  // ── Bangladesh delivery address ──────────────────────────────────────────
  // A snapshot, not a reference to `customer_addresses`: the address book can
  // be edited or deleted afterwards, and where a delivered parcel actually
  // went must not change when the customer moves house.
  division     String
  district     String
  upazila      String
  area         String?
  address_line String
  landmark     String?
  postal_code  String?

  /// Map pin, when the customer set one. The written address above stays
  /// authoritative — this is an aid for the rider, not a replacement.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  note String?

  subtotal        Decimal @db.Decimal(10, 2)
  delivery_charge Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  /// The Sale written when the order is marked delivered — that is the point
  /// the cash actually arrives, so that is when it enters the books.
  sale_id String? @unique

  /// Guards the restock on cancellation against running twice.
  stock_restored Boolean   @default(false)
  cancelled_at   DateTime?
  delivered_at   DateTime?

  placed_at  DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop          Shop           @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  storeCustomer StoreCustomer? @relation(fields: [store_customer_id], references: [id], onDelete: SetNull)
  sale          Sale?          @relation(fields: [sale_id], references: [id], onDelete: SetNull)

  items        OnlineOrderItem[]
  stockLedgers StockLedger[]

  @@unique([shop_id, order_number])
  @@index([shop_id, status, placed_at])
  @@index([shop_id, placed_at])
  @@index([store_id])
  @@index([customer_id])
  @@index([customer_phone])
  /// Drives "my orders", which is always newest-first for one account.
  @@index([store_customer_id, placed_at])
  @@map("online_orders")
}

model OnlineOrderItem {
  id         String @id @default(uuid())
  order_id   String
  variant_id String

  // Denormalized snapshots — intentional, exactly as SaleItem does it. What the
  // customer bought must keep reading the way it did at checkout even after the
  // product is renamed, repriced or deleted.
  product_name String
  variant_name String?
  image_url    String?

  unit_price Decimal @db.Decimal(10, 2)
  quantity   Int
  total      Decimal @db.Decimal(10, 2)

  order   OnlineOrder    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([variant_id])
  @@map("online_order_items")
}
